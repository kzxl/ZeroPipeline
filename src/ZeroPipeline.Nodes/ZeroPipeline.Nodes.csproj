  <ItemGroup>
    <ProjectReference Include="..\ZeroPipeline.Core\ZeroPipeline.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroPrimitives.Core" Version="1.3.0" />
    <PackageReference Include="ZeroGraphics.Core" Version="1.5.0" />
    <PackageReference Include="ZeroGraphics.Imaging" Version="1.5.0" />
    <PackageReference Include="ZeroGraphics.Vision" Version="1.5.0" />
    <PackageReference Include="ZeroTensor.Core" Version="1.1.0" />
    <PackageReference Include="ZeroInference.Core" Version="1.3.0" />
    <PackageReference Include="ZeroStorage.Core" Version="1.3.0" />
    <PackageReference Include="ZeroComm.Core" Version="1.2.0" />
  </ItemGroup>
</Project>
